# Bridge Relayer Configuration
# Copy to .env and fill in values

# Database path
DB_PATH=./relayer.db

# Relayer wallet private key (for submitting txs, pays gas)
RELAYER_PRIVATE_KEY=0x...

# API key for Director communication
DIRECTOR_API_KEY=your-secure-api-key-here

# Polling interval in milliseconds
POLL_INTERVAL=5000

# RPC Endpoints
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_POLYGON=https://polygon-rpc.com
RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
RPC_BASE=https://mainnet.base.org
RPC_BSC=https://bsc-dataseed.binance.org
RPC_OPTIMISM=https://mainnet.optimism.io

# Bridge Contract Addresses (fill after deployment)
BRIDGE_ETHEREUM=0x...
BRIDGE_ARBITRUM=0x...
BRIDGE_POLYGON=0x...
BRIDGE_AVALANCHE=0x...
BRIDGE_BASE=0x...
BRIDGE_BSC=0x...
BRIDGE_OPTIMISM=0x...

# Director Signer URLs (9 directors)
DIRECTOR_1_URL=http://director1.etrid.io:3100
DIRECTOR_2_URL=http://director2.etrid.io:3100
DIRECTOR_3_URL=http://director3.etrid.io:3100
DIRECTOR_4_URL=http://director4.etrid.io:3100
DIRECTOR_5_URL=http://director5.etrid.io:3100
DIRECTOR_6_URL=http://director6.etrid.io:3100
DIRECTOR_7_URL=http://director7.etrid.io:3100
DIRECTOR_8_URL=http://director8.etrid.io:3100
DIRECTOR_9_URL=http://director9.etrid.io:3100
