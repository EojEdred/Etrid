# Director Signer Configuration
# Copy to .env and fill in values

# Port to run on (each Director uses different port)
PORT=3100

# Director index (0-8)
DIRECTOR_INDEX=0

# Director's ECDSA private key (KEEP SECRET!)
DIRECTOR_PRIVATE_KEY=0x...

# API key for authentication (shared with relayer)
API_KEY=your-secure-api-key-here

# RPC endpoints for source transaction verification
RPC_ETHEREUM=https://eth.llamarpc.com
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_POLYGON=https://polygon-rpc.com
RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
RPC_BASE=https://mainnet.base.org
RPC_BSC=https://bsc-dataseed.binance.org
RPC_OPTIMISM=https://mainnet.optimism.io
