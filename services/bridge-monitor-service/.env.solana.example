# Solana Bridge Monitor Configuration
# Copy this file to .env and configure for your environment

# ========================================
# Solana RPC Configuration
# ========================================

# Solana RPC endpoint
# - Mainnet: https://api.mainnet-beta.solana.com
# - Devnet: https://api.devnet.solana.com
# - Testnet: https://api.testnet.solana.com
# - Custom: https://your-solana-node.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana WebSocket endpoint (for real-time logs)
# - Mainnet: wss://api.mainnet-beta.solana.com
# - Devnet: wss://api.devnet.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Bridge program ID (deployed on Solana)
# This is the on-chain program that handles deposits and burns
SOLANA_BRIDGE_PROGRAM_ID=BRGPidxhcsLVFBQ5zZqRHZ8bKRAHhAhiEDCfqELV8M7u

# ========================================
# ËTRID Substrate Configuration
# ========================================

# ËTRID node WebSocket endpoint
SUBSTRATE_WS_URL=ws://127.0.0.1:9944

# ËTRID chain ID
SUBSTRATE_CHAIN_ID=2

# ========================================
# Relayer Configuration
# ========================================

# Relayer account seed phrase (keep secret!)
# For production, use a secure key management system
RELAYER_SEED=//Alice

# Relayer Substrate address (derived from seed)
RELAYER_ADDRESS=5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY

# ========================================
# Bridge Parameters
# ========================================

# Minimum confirmations for Solana (31 = finalized, 12-20 = confirmed)
MIN_CONFIRMATIONS=31

# Slot polling interval (milliseconds)
# Solana has ~400ms block time
SLOT_POLL_INTERVAL=400

# ========================================
# Service Configuration
# ========================================

# Service port
PORT=3000

# Metrics port (Prometheus)
METRICS_PORT=9090

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Redis URL (optional, for caching)
REDIS_URL=redis://localhost:6379

# ========================================
# Monitoring & Alerts
# ========================================

# Prometheus metrics enabled
METRICS_ENABLED=true

# Health check interval (milliseconds)
HEALTH_CHECK_INTERVAL=30000

# Alert webhook URL (for critical alerts)
# ALERT_WEBHOOK_URL=https://your-webhook.com/alerts

# Slack webhook URL (for notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ========================================
# Performance Tuning
# ========================================

# Maximum RPC retries before failing
MAX_RETRIES=5

# Retry delay (milliseconds)
RETRY_DELAY=5000

# Transaction fetch timeout (milliseconds)
TX_FETCH_TIMEOUT=10000

# ========================================
# Token Configuration
# ========================================

# Wrapped ETR token mint on Solana
WETR_MINT=CA4ALvCam7N3ya8d2axp3AakwNdCdQchQNNwYSYiMRR4

# USDC mint (EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# USDT mint
USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# ========================================
# Development / Testing
# ========================================

# Enable debug logging for Solana transactions
# DEBUG_TRANSACTIONS=true

# Dry run mode (don't submit extrinsics)
# DRY_RUN=false

# Test mode (use devnet)
# TEST_MODE=false

# ========================================
# Production Recommendations
# ========================================

# 1. Use a dedicated RPC endpoint (QuickNode, Alchemy, Triton)
#    SOLANA_RPC_URL=https://your-dedicated-rpc.com
#    SOLANA_WS_URL=wss://your-dedicated-rpc.com

# 2. Enable Redis for caching and deduplication
#    REDIS_URL=redis://your-redis-cluster:6379

# 3. Set up monitoring
#    METRICS_ENABLED=true
#    ALERT_WEBHOOK_URL=https://your-alerting-service.com

# 4. Use secure key management (AWS KMS, HashiCorp Vault, etc.)
#    Don't store private keys in .env in production!

# 5. Tune performance based on your needs
#    MIN_CONFIRMATIONS=31 (finalized - safest)
#    MIN_CONFIRMATIONS=20 (confirmed - faster but less safe)
