# Bridge Monitor Service Configuration

# General
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
NETWORK=mainnet

# XRP Monitor
XRP_ENABLED=true
XRP_RPC_URL=wss://xrplcluster.com
XRP_BRIDGE_TYPE=classic
XRP_BRIDGE_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
XRP_MIN_CONFIRMATIONS=1
XRP_RECONNECT_ATTEMPTS=5
XRP_RECONNECT_DELAY=5000
XRP_MIN_AMOUNT=1000000

# Cardano Monitor
CARDANO_ENABLED=true
CARDANO_BLOCKFROST_API_KEY=mainnetXXXXXXXXXXXXXXXXXXXXXXXX
CARDANO_BLOCKFROST_URL=https://cardano-mainnet.blockfrost.io/api/v0
CARDANO_BRIDGE_ADDRESS=addr1qXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CARDANO_MIN_CONFIRMATIONS=15
CARDANO_POLL_INTERVAL=20000
CARDANO_MAX_RETRIES=5
CARDANO_RETRY_DELAY=10000
CARDANO_MIN_AMOUNT=1000000

# Stellar Monitor
STELLAR_ENABLED=true
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_BRIDGE_ACCOUNT=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_MIN_CONFIRMATIONS=3
STELLAR_RECONNECT_TIMEOUT=5000
STELLAR_MIN_AMOUNT=1.0000000
