  "attestationFlow": {
    "xrplClassic": [
      "1. Deposit XRP to ETRID custody account with destination tag",
      "2. XRPL transaction validated (instant finality)",
      "3. Relayer detects payment and notifies Directors",
      "4. Directors sign attestation message",
      "5. 5+ signatures collected, attestation submitted to Primearc",
      "6. Wrapped XRP minted on ETRID"
    ],
    "evmSidechain": [
      "1. User locks XRP in EVM bridge contract",
      "2. Contract emits Lock event",
      "3. Relayer detects event and notifies Directors",
      "4. Directors sign EVM-compatible attestation",
      "5. Attestation verified on-chain (same as other EVM chains)"
    ]
  },

