  "attestationFlow": {
    "description": "Off-chain attestation with on-chain multisig execution",
    "steps": [
      "1. Bridge request detected on source chain",
      "2. Relayer broadcasts request to all 9 Directors",
      "3. Each Director signs the bridge request message",
      "4. Signatures collected off-chain",
      "5. When 5+ signatures collected, multisig transaction created",
      "6. PSBT created and signed by available Directors",
      "7. Transaction broadcast to Bitcoin network"
    ]
  },

