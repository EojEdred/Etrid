# ═══════════════════════════════════════════════════════════════════════
# Ëtrid Bridge Monitoring Stack - Environment Configuration
# Copy this file to .env.bridge-monitors and configure with your values
# ═══════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════
# General Configuration
# ═══════════════════════════════════════════════════════════════════════

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Environment: development, staging, production
ENVIRONMENT=production

# Network ID
NETWORK_ID=etrid-mainnet

# ═══════════════════════════════════════════════════════════════════════
# FlareChain Configuration
# ═══════════════════════════════════════════════════════════════════════

FLARECHAIN_WS_URL=ws://10.0.0.100:9944
FLARECHAIN_HTTP_URL=http://10.0.0.100:9933

# ═══════════════════════════════════════════════════════════════════════
# Bitcoin PBC Configuration
# ═══════════════════════════════════════════════════════════════════════

BITCOIN_PBC_WS_URL=ws://10.0.0.107:9944
BITCOIN_RPC_URL=https://bitcoin-mainnet.your-rpc-provider.com
BITCOIN_RPC_USER=your_btc_rpc_user
BITCOIN_RPC_PASSWORD=your_btc_rpc_password
BTC_CONFIRMATION_BLOCKS=6
BTC_BRIDGE_CONTRACT=5C4hrfjw9DjXZTzV3MwzrrAr9P1MJhSrvWGWqi1eSuyUpnhM

# ═══════════════════════════════════════════════════════════════════════
# Solana PBC Configuration
# ═══════════════════════════════════════════════════════════════════════

SOLANA_PBC_WS_URL=ws://10.0.0.101:9944
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOL_CONFIRMATION_BLOCKS=32
SOL_BRIDGE_PROGRAM=SoLBridgeProgram11111111111111111111111111111

# ═══════════════════════════════════════════════════════════════════════
# Ethereum PBC Configuration
# ═══════════════════════════════════════════════════════════════════════

ETHEREUM_PBC_WS_URL=ws://10.0.0.103:9944
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
ETHEREUM_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_INFURA_PROJECT_ID
ETH_CONFIRMATION_BLOCKS=12
ETH_BRIDGE_CONTRACT=0x1234567890123456789012345678901234567890

# ═══════════════════════════════════════════════════════════════════════
# BNB Smart Chain PBC Configuration
# ═══════════════════════════════════════════════════════════════════════

BNB_PBC_WS_URL=ws://10.0.0.102:9944
BNB_RPC_URL=https://bsc-dataseed1.binance.org
BNB_WS_URL=wss://bsc-ws-node.nariox.org:443
BNB_CONFIRMATION_BLOCKS=15
BNB_BRIDGE_CONTRACT=0xabcdef1234567890abcdef1234567890abcdef12

# ═══════════════════════════════════════════════════════════════════════
# Polygon PBC Configuration
# ═══════════════════════════════════════════════════════════════════════

POLYGON_PBC_WS_URL=ws://10.0.0.104:9944
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_CONFIRMATION_BLOCKS=128
POLYGON_BRIDGE_CONTRACT=0xfedcba0987654321fedcba0987654321fedcba09

# ═══════════════════════════════════════════════════════════════════════
# Tron PBC Configuration
# ═══════════════════════════════════════════════════════════════════════

TRON_PBC_WS_URL=ws://10.0.0.105:9944
TRON_RPC_URL=https://api.trongrid.io
TRON_API_KEY=your_trongrid_api_key
TRX_CONFIRMATION_BLOCKS=19
TRX_BRIDGE_CONTRACT=TXYZabcdefghijklmnopqrstuvwxyz1234

# ═══════════════════════════════════════════════════════════════════════
# XRP Ledger PBC Configuration
# ═══════════════════════════════════════════════════════════════════════

XRP_PBC_WS_URL=ws://10.0.0.106:9944
XRP_RPC_URL=https://s1.ripple.com:51234
XRP_WS_URL=wss://s1.ripple.com
XRP_CONFIRMATION_BLOCKS=1
XRP_BRIDGE_ACCOUNT=rXRPBridgeAccount123456789012345678

# ═══════════════════════════════════════════════════════════════════════
# Attestation Configuration
# ═══════════════════════════════════════════════════════════════════════

# Number of attestations required (M-of-N)
ATTESTATION_THRESHOLD=3
MIN_ATTESTATIONS=3
MAX_ATTESTATIONS=5

# Attestation timeout in milliseconds (5 minutes)
ATTESTATION_TIMEOUT=300000

# ═══════════════════════════════════════════════════════════════════════
# Attestation Aggregator Private Keys
# SECURITY: Generate unique keys for each aggregator instance
# Use: subkey generate --scheme sr25519
# ═══════════════════════════════════════════════════════════════════════

AGGREGATOR_1_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
AGGREGATOR_2_PRIVATE_KEY=0x2222222222222222222222222222222222222222222222222222222222222222
AGGREGATOR_3_PRIVATE_KEY=0x3333333333333333333333333333333333333333333333333333333333333333
AGGREGATOR_4_PRIVATE_KEY=0x4444444444444444444444444444444444444444444444444444444444444444
AGGREGATOR_5_PRIVATE_KEY=0x5555555555555555555555555555555555555555555555555555555555555555

# ═══════════════════════════════════════════════════════════════════════
# Relayer Configuration
# ═══════════════════════════════════════════════════════════════════════

# Relayer private key for submitting proofs to FlareChain
RELAYER_PRIVATE_KEY=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Minimum number of aggregators that must agree before submission
MIN_AGGREGATOR_CONSENSUS=3

# Maximum gas price in wei (1000 Gwei)
MAX_GAS_PRICE=1000000000000

# Submission retry configuration
SUBMISSION_RETRY_ATTEMPTS=5
SUBMISSION_RETRY_DELAY=10000

# ═══════════════════════════════════════════════════════════════════════
# Monitoring Configuration
# ═══════════════════════════════════════════════════════════════════════

# Prometheus retention
PROMETHEUS_RETENTION_TIME=90d
PROMETHEUS_RETENTION_SIZE=100GB

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=etrid2025

# ═══════════════════════════════════════════════════════════════════════
# Alert Configuration
# ═══════════════════════════════════════════════════════════════════════

# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty integration key
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key

# Email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@etrid.com
SMTP_PASSWORD=your_smtp_password
ALERT_EMAIL_TO=ops@etrid.com
ALERT_EMAIL_FROM=alerts@etrid.com

# ═══════════════════════════════════════════════════════════════════════
# Performance Tuning
# ═══════════════════════════════════════════════════════════════════════

# WebSocket reconnection settings
WS_RECONNECT_DELAY=5000
WS_MAX_RECONNECT_ATTEMPTS=10

# Polling intervals (milliseconds)
BLOCK_POLL_INTERVAL=12000
STATE_CHECK_INTERVAL=30000
HEALTH_CHECK_INTERVAL=60000

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=10

# Database settings (if using PostgreSQL for state)
DATABASE_URL=postgresql://etrid:password@localhost:5432/bridge_monitor
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30000

# Redis settings (if using Redis for caching)
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# ═══════════════════════════════════════════════════════════════════════
# Security Settings
# ═══════════════════════════════════════════════════════════════════════

# Enable HTTPS for APIs
ENABLE_HTTPS=false
SSL_CERT_PATH=/etc/ssl/certs/etrid.crt
SSL_KEY_PATH=/etc/ssl/private/etrid.key

# API authentication
API_AUTH_ENABLED=true
API_AUTH_TOKEN=your_secure_api_token_here

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://bridge.etrid.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ═══════════════════════════════════════════════════════════════════════
# Feature Flags
# ═══════════════════════════════════════════════════════════════════════

# Enable/disable specific features
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_PROFILING=false
ENABLE_DEBUG_ENDPOINTS=false

# Enable/disable specific chains (for testing)
ENABLE_BTC_MONITOR=true
ENABLE_SOL_MONITOR=true
ENABLE_ETH_MONITOR=true
ENABLE_BNB_MONITOR=true
ENABLE_POLYGON_MONITOR=true
ENABLE_TRX_MONITOR=true
ENABLE_XRP_MONITOR=true

# ═══════════════════════════════════════════════════════════════════════
# Development/Testing Settings
# ═══════════════════════════════════════════════════════════════════════

# Use testnet endpoints (override mainnet settings)
USE_TESTNET=false

# Mock external chain connections for testing
MOCK_EXTERNAL_CHAINS=false

# Enable verbose logging
VERBOSE_LOGGING=false

# Dry run mode (don't submit actual transactions)
DRY_RUN=false
